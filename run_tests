#!/usr/bin/env python3
"""
Simple cross-platform test runner: installs requirements and runs pytest.
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(__file__)
R = os.path.join(ROOT, "requirements.txt")
print("Installing requirements...")
subprocess.check_call([sys.executable, "-m", "pip", "install", "-r", R])
print("Running tests...")
subprocess.check_call([sys.executable, "-m", "pytest", "-q"])
print("Done")
